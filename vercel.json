{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "cleanUrls": true,

  "redirects": [
    {
      "source": "/blog/:slug*",
      "destination": "/resources/:slug*",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/resources/:slug+",
      "destination": "/resources"
    }
  ],

  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
