---
// Web-app destinations (browse the actual product without installing)
const appLinks = [
  { href: 'https://app.fampass.io/events', label: 'Events' },
  { href: 'https://app.fampass.io/guides', label: 'Guides' },
  { href: 'https://app.fampass.io/deals', label: 'Deals' },
];
// Marketing-site sections
const links = [
  { href: '/#features', label: 'Features' },
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/resources/', label: 'Resources' },
];
---
<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">
      <img src="/assets/images/logo.png?v=7" alt="FamPass" width="34" height="34" />
      <span>FamPass</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      {appLinks.map(l => <a href={l.href} class="site-header__nav-app">{l.label}</a>)}
      <span class="site-header__nav-sep" aria-hidden="true"></span>
      <div class="site-header__more" data-dropdown>
        <button type="button" class="site-header__more-btn" aria-haspopup="true" aria-expanded="false">
          More
          <svg class="site-header__more-caret" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="site-header__more-menu" role="menu">
          {links.map(l => <a href={l.href} role="menuitem">{l.label}</a>)}
        </div>
      </div>
    </nav>

    <div class="site-header__cta">
      <a href="https://app.fampass.io" class="site-header__login">Open web app</a>
      <a href="https://apps.apple.com/us/app/fampass/id6760528354" target="_blank" rel="noopener" class="btn btn--primary btn--sm">Get the app</a>
    </div>

    <button class="site-header__toggle" aria-label="Open menu" aria-expanded="false" aria-controls="site-header-mobile">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
        <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="site-header__mobile" id="site-header-mobile" hidden>
    <div class="container">
      <span class="site-header__mobile-label">Browse online</span>
      {appLinks.map(l => <a href={l.href}>{l.label}</a>)}
      <span class="site-header__mobile-label">Learn more</span>
      {links.map(l => <a href={l.href}>{l.label}</a>)}
      <a href="https://app.fampass.io" class="site-header__mobile-webapp">Open web app →</a>
      <a href="https://apps.apple.com/us/app/fampass/id6760528354" target="_blank" rel="noopener" class="btn btn--primary">Get the app</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255,255,255,.85);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-block: 14px;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .site-header__brand img {
    border-radius: 8px;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
  }
  .site-header__nav a {
    padding: 8px 12px;
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    white-space: nowrap;
    transition: background .15s ease, color .15s ease;
  }
  .site-header__nav a:hover {
    color: var(--color-ink);
    background: rgba(26,26,26,.05);
  }
  .site-header__nav-app { color: var(--color-ink); font-weight: 600; }
  .site-header__nav-app:hover { color: var(--color-accent); background: var(--color-accent-lo); }
  .site-header__nav-sep {
    width: 1px;
    height: 20px;
    margin-inline: 6px;
    background: var(--color-line);
  }

  /* "More" dropdown */
  .site-header__more { position: relative; }
  .site-header__more-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 8px 12px;
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    white-space: nowrap;
    cursor: pointer;
    transition: background .15s ease, color .15s ease;
  }
  .site-header__more:hover .site-header__more-btn,
  .site-header__more:focus-within .site-header__more-btn {
    color: var(--color-ink);
    background: rgba(26,26,26,.05);
  }
  .site-header__more-caret { transition: transform .15s ease; }
  .site-header__more:hover .site-header__more-caret,
  .site-header__more:focus-within .site-header__more-caret { transform: rotate(180deg); }

  .site-header__more-menu {
    position: absolute;
    top: 100%;
    right: 0;
    min-width: 200px;
    margin-top: 8px;
    padding: 6px;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity .15s ease, transform .15s ease, visibility .15s ease;
  }
  /* invisible bridge so hover survives the gap between button and menu */
  .site-header__more-menu::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    right: 0;
    height: 8px;
  }
  .site-header__more:hover .site-header__more-menu,
  .site-header__more:focus-within .site-header__more-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
  .site-header__more-menu a {
    margin-left: 0;
    padding: 9px 12px;
    border-radius: var(--radius-sm, 8px);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    white-space: nowrap;
  }
  .site-header__more-menu a:hover {
    color: var(--color-ink);
    background: rgba(26,26,26,.05);
  }

  .site-header__cta { display: inline-flex; align-items: center; gap: 10px; }
  .site-header__cta .btn {
    padding: 10px 18px;
    font-size: 0.94rem;
  }
  .site-header__login {
    padding: 8px 12px;
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    transition: background .15s ease, color .15s ease;
  }
  .site-header__login:hover { color: var(--color-ink); background: rgba(26,26,26,.05); }

  .site-header__toggle { display: none; color: var(--color-ink); padding: 8px; }

  .site-header__mobile {
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
  }
  .site-header__mobile .container {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-block: 12px 18px;
  }
  .site-header__mobile a {
    padding: 12px 14px;
    border-radius: var(--radius-md);
    color: var(--color-ink);
    font-weight: 500;
  }
  .site-header__mobile a.btn {
    margin-top: 8px;
    color: #fff;
  }
  .site-header__mobile-label {
    padding: 12px 14px 4px;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    color: var(--color-ink-muted);
  }
  .site-header__mobile-webapp {
    margin-top: 8px;
    color: var(--color-accent) !important;
    font-weight: 600 !important;
  }

  @media (max-width: 820px) {
    .site-header__nav, .site-header__cta { display: none; }
    .site-header__toggle { display: inline-flex; margin-left: auto; }
  }
</style>

<script is:inline>
  (() => {
    const btn = document.querySelector('.site-header__toggle');
    const panel = document.getElementById('site-header-mobile');
    if (!btn || !panel) return;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
    panel.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    }));
  })();

  // "More" dropdown(s): open on hover/focus via CSS; JS only keeps aria-expanded
  // in sync and closes on Escape. Works for mouse, keyboard, and touch (tap =
  // focus, which triggers :focus-within).
  (() => {
    document.querySelectorAll('[data-dropdown]').forEach(dd => {
      const trigger = dd.querySelector('.site-header__more-btn');
      if (!trigger) return;
      const sync = open => trigger.setAttribute('aria-expanded', String(open));
      dd.addEventListener('mouseenter', () => sync(true));
      dd.addEventListener('mouseleave', () => { if (!dd.contains(document.activeElement)) sync(false); });
      dd.addEventListener('focusin', () => sync(true));
      dd.addEventListener('focusout', e => { if (!dd.contains(e.relatedTarget)) sync(false); });
      dd.addEventListener('keydown', e => { if (e.key === 'Escape') { sync(false); trigger.blur(); } });
    });
  })();
</script>
