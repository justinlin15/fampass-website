---
const year = new Date().getFullYear();

// Active state for the current page. Normalize trailing slashes so `/resources/`
// matches the `/resources` pathname (Vercel `cleanUrls` serves extensionless paths).
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const currentPath = norm(Astro.url.pathname);
const isCurrent = (href: string) => {
  if (!href || href.startsWith('http') || href.includes('#')) return false;
  return norm(href) === currentPath;
};
---
<footer class="site-footer">
  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__logo">
        <img src="/assets/images/logo.png?v=7" alt="FamPass" width="36" height="36" />
        <span>FamPass</span>
      </a>
      <p class="site-footer__tagline">The local guide every parent wishes they had.</p>
      <a href="https://apps.apple.com/us/app/fampass/id6760528354" class="app-store-badge" target="_blank" rel="noopener">
        <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" />
      </a>
      <a href="https://app.fampass.io/events" class="site-footer__browse">On Android or desktop? Use it in your browser →</a>
    </div>

    <div class="site-footer__cols">
      <div>
        <h5>Browse online</h5>
        <ul>
          <li><a href="https://app.fampass.io/events">Events</a></li>
          <li><a href="https://app.fampass.io/guides">Guides</a></li>
          <li><a href="https://app.fampass.io/deals">Deals</a></li>
          <li><a href="https://app.fampass.io">Open web app</a></li>
        </ul>
      </div>
      <div>
        <h5>Product</h5>
        <ul>
          <li><a href="/#features">Features</a></li>
          <li><a href="/#how-it-works">How it works</a></li>
          <li><a href="/#pricing">Pricing</a></li>
          <li><a href="/#faq">FAQ</a></li>
        </ul>
      </div>
      <div>
        <h5>Company</h5>
        <ul>
          <li><a href="/about" class:list={[{ 'is-active': isCurrent('/about') }]} aria-current={isCurrent('/about') ? 'page' : undefined}>About</a></li>
          <li><a href="/resources/" class:list={[{ 'is-active': isCurrent('/resources/') }]} aria-current={isCurrent('/resources/') ? 'page' : undefined}>Resources</a></li>
          <li><a href="/support" class:list={[{ 'is-active': isCurrent('/support') }]} aria-current={isCurrent('/support') ? 'page' : undefined}>Support</a></li>
          <li><a href="/list-your-deal" class:list={[{ 'is-active': isCurrent('/list-your-deal') }]} aria-current={isCurrent('/list-your-deal') ? 'page' : undefined}>For Businesses</a></li>
        </ul>
      </div>
      <div>
        <h5>Legal</h5>
        <ul>
          <li><a href="/privacy-policy" class:list={[{ 'is-active': isCurrent('/privacy-policy') }]} aria-current={isCurrent('/privacy-policy') ? 'page' : undefined}>Privacy</a></li>
          <li><a href="/terms-of-service" class:list={[{ 'is-active': isCurrent('/terms-of-service') }]} aria-current={isCurrent('/terms-of-service') ? 'page' : undefined}>Terms</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <span>© {year} FamPass. Made for families.</span>
  </div>
</footer>

<style>
  .site-footer {
    background: #FAF6F1;
    border-top: 1px solid var(--color-line);
    padding-block: 64px 32px;
    color: var(--color-ink-soft);
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 56px;
    align-items: start;
  }
  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .site-footer__logo img { border-radius: 8px; }
  .site-footer__tagline {
    margin-top: 14px;
    margin-bottom: 22px;
    max-width: 320px;
    font-size: 0.98rem;
  }
  .site-footer__browse {
    display: inline-block;
    margin-top: 16px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-accent);
    transition: color .15s ease;
  }
  .site-footer__browse:hover { color: var(--color-accent-hi); text-decoration: underline; }
  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .site-footer__cols h5 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 14px;
    color: var(--color-ink);
    font-weight: 600;
  }
  .site-footer__cols ul { display: flex; flex-direction: column; gap: 10px; }
  .site-footer__cols a {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    transition: color .15s ease;
  }
  .site-footer__cols a:hover { color: var(--color-accent); }
  .site-footer__cols a.is-active { color: var(--color-accent); font-weight: 600; }

  .site-footer__bottom {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
    font-size: 0.88rem;
    color: var(--color-ink-muted);
  }

  @media (max-width: 820px) {
    .site-footer__top { grid-template-columns: 1fr; gap: 40px; }
    .site-footer__cols { grid-template-columns: repeat(2, 1fr); gap: 28px; }
  }
</style>
