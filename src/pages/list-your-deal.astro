---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base
  title="List Your Deal on FamPass — Free Local Business Exposure"
  description="Reach local families planning their week with FamPass. Submit a deal or promotion for free — no account needed."
  canonical="https://fampass.io/list-your-deal"
  newsletterStrip={false}
>
  <PageHero
    eyebrow="For Local Businesses"
    title="Get your deal in front of local families."
    lede="FamPass is where parents go to plan their week. Submit a deal or promotion for free — we review every submission and feature the ones that fit."
  />

  <section class="section">
    <div class="container">
      <div class="deal-grid">
        <!-- context -->
        <aside class="deal-side">
          <article class="support-card">
            <span class="support-card__icon" aria-hidden="true">1</span>
            <h3>Submit your deal</h3>
            <p>Fill out the short form — no account, no login, takes about a minute.</p>
          </article>

          <article class="support-card">
            <span class="support-card__icon" aria-hidden="true">2</span>
            <h3>We review it</h3>
            <p>A real person looks at every submission, usually within a few days.</p>
          </article>

          <article class="support-card">
            <span class="support-card__icon" aria-hidden="true">3</span>
            <h3>Families see it</h3>
            <p>Approved deals appear in the FamPass app's Deals tab for local parents browsing what to do.</p>
          </article>

          <article class="support-card">
            <span class="support-card__icon" aria-hidden="true">✉</span>
            <h3>Questions first?</h3>
            <p>Happy to talk it through before you submit anything.</p>
            <a href="mailto:dev@fampass.io" class="btn btn--ghost btn--sm">dev@fampass.io</a>
          </article>
        </aside>

        <!-- form -->
        <div class="support-form">
          <h2>Submit your deal</h2>
          <p class="lede mt-2">Free to submit. We'll only reach out if it's a fit.</p>

          <form id="dealForm" class="mt-6">
            <div class="field">
              <label for="businessName">Business name</label>
              <input type="text" id="businessName" name="businessName" placeholder="Sunshine Gymnastics" required />
            </div>
            <div class="field">
              <label for="contactEmail">Contact email</label>
              <input type="email" id="contactEmail" name="contactEmail" placeholder="you@yourbusiness.com" required />
            </div>
            <div class="field">
              <label for="dealDescription">Deal or offer description</label>
              <textarea id="dealDescription" name="dealDescription" rows="5" placeholder="e.g. 20% off a first month of classes for new families" required></textarea>
            </div>
            <div class="field">
              <label for="expirationDate">Expiration date</label>
              <input type="date" id="expirationDate" name="expirationDate" required />
            </div>
            <div class="field">
              <label for="logoUrl">Logo or image link (optional)</label>
              <input type="url" id="logoUrl" name="logoUrl" placeholder="https://yourbusiness.com/logo.png" />
            </div>
            <!-- Honeypot — hidden from real users, catches simple bots -->
            <div class="field" style="position: absolute; left: -9999px;" aria-hidden="true">
              <label for="hp">Leave blank</label>
              <input type="text" id="hp" name="hp" tabindex="-1" autocomplete="off" />
            </div>
            <button type="submit" class="btn btn--primary">Submit Your Deal</button>
            <div id="dealMessage" class="form-message" role="status" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Firebase SDK + deal submission handler -->
  <script is:inline src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script is:inline src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>
  <script is:inline src="/js/firebase-config.js"></script>
  <script is:inline src="/js/deal-submission.js"></script>
</Base>

<style>
  .deal-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }

  .deal-side { display: flex; flex-direction: column; gap: 16px; }
  .support-card {
    background: #fff;
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-lg);
    padding: 24px;
  }
  .support-card__icon {
    display: inline-flex;
    width: 40px; height: 40px;
    background: var(--color-accent-lo);
    color: var(--color-accent-hi);
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 14px;
  }
  .support-card h3 {
    font-size: 1.1rem;
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 6px;
  }
  .support-card p {
    color: var(--color-ink-soft);
    font-size: 0.94rem;
    line-height: 1.5;
  }
  .support-card .btn { margin-top: 12px; }

  .support-form {
    background: var(--color-bg-warm);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-lg);
    padding: clamp(28px, 4vw, 44px);
  }
  .support-form h2 { font-size: 1.8rem; }

  @media (max-width: 880px) {
    .deal-grid { grid-template-columns: 1fr; }
  }
</style>
